{
  "scripts": {
    "css:watch": "sass --watch ./resources/public/css/main.scss ./resources/public/css/main.min.css --no-source-map --style compressed",
    "css:minify": "sass ./resources/public/css/main.scss ./resources/public/css/main.min.css --no-source-map --style compressed",
    "css:purge": "yarn purgecss -c purgecss.config.js",
    "watch": "shadow-cljs watch app;",
    "server": "shadow-cljs server;",
    "build": "clojure -P -M:frontend && yarn css:minify && yarn shadow-cljs release app",
    "lint:js": "eslint .",
    "format:write": "prettier --write .",
    "format:check": "prettier --check ."
  },
